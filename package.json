{
  "name": "busmora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "build:e2e": "node scripts/prepare-e2e-build.mjs && NEXT_TEST_OUTPUT=.next-e2e next build",
    "start:e2e": "NEXT_TEST_OUTPUT=.next-e2e next start",
    "lint": "oxlint src scripts e2e playwright.config.ts next.config.ts tailwind.config.js",
    "preview": "next start",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report test-results/e2e/report",
    "test:db:local": "node scripts/local-migration-check.mjs",
    "test:unit": "AI_MODE=test node --experimental-transform-types --import ./scripts/testing/ts-register.mjs --test tests/orchestrator/*.test.ts tests/tasks/*.test.ts tests/admin/*.test.ts tests/chat/*.test.ts tests/roadmap/*.test.ts tests/publishing/*.test.ts tests/agents/*.test.ts",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test:posts:db": "node scripts/db-check.cjs scripts/planned-posts-db-check.sql",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@composio/core": "0.28.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "dompurify": "3.4.18",
    "lucide-react": "^1.59.0",
    "marked": "^18.1.1",
    "next": "^16.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reactflow": "^11.11.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}