NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local Supabase (npx supabase start) default publishable + secret keys.
# Copy .env.example to .env and run `npx supabase start` to use the local stack
# so migrations never touch the shared/hosted project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never prefix this with NEXT_PUBLIC_.
# Preferred: the current Supabase secret key (sb_secret_...).
SUPABASE_SECRET_KEY=
# Legacy service-role JWT (used only when SUPABASE_SECRET_KEY is unset).
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (server-side migrations/admin only).
# Local Supabase default: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Server-side AI (managed model). AI_API_KEY is the provider key; set AI_PROVIDER/AI_MODEL.
# AI Execution Mode: 'production' (uses SovereignEG, Groq, Dahl) | 'test' (Groq & Dahl only, zero SovereignEG usage)
AI_MODE=production
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
AI_API_KEY=
AI_BASE_URL=
AI_ALLOWED_BASE_URLS=
# Server-side Firecrawl research/search key.
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
COMPOSIO_API_KEY=
EXA_API_KEY=

# SovereignEG & Dahl endpoints
SOVEREIGNEG_API_KEY=
SOVEREIGNEG_BASE_URL=https://backend.sovereigneg.com/v1
DAHL_API_KEY=
DAHL_BASE_URL=https://inference.dahl.global/v1

OAUTH_APP_URL=http://localhost:3000

# Real E2E environment. Use a disposable Supabase project. The suite refuses a
# remote project unless E2E_ALLOW_REMOTE=1 is explicitly set.
E2E_SUPABASE_URL=
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SECRET_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_DATABASE_URL=
E2E_AI_PROVIDER=
E2E_AI_MODEL=
E2E_AI_API_KEY=
E2E_FIRECRAWL_API_KEY=
E2E_BASE_URL=http://127.0.0.1:4179
E2E_ALLOW_REMOTE=0
E2E_EMAIL_DOMAIN=example.com

# Local disposable database checks (Windows/Node, no Python). Never the shared Supabase project.
LOCAL_PG_URL=   # local disposable DB checks only (npm run test:db:local / test:posts:db); must be localhost
PSQL=           # optional full path to psql.exe if it is not on PATH

# Facebook Page publishing (Phase 4). Server-only; never prefix with NEXT_PUBLIC_.
COMPOSIO_API_KEY=                   # Composio project API key (ak_...)
COMPOSIO_FACEBOOK_AUTH_CONFIG_ID=   # ac_... Composio-managed Facebook auth config
PUBLISHING_PROVIDER=composio        # composio | fake | disabled  (fake is refused in production)
PUBLISHING_FAKE_OUTCOME=confirmed   # fake only: confirmed | failed | uncertain | timeout
CRON_SECRET=                        # long random string for /api/cron/publish-due

# Admin execution observability dashboard (server-only).
# Provision the operator with `ADMIN_EMAIL=... ADMIN_PASSWORD=... node scripts/provision-admin.mjs`
# which prints the ADMIN_USER_ID to pin here. Access is denied when neither is set.
ADMIN_USER_ID=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to 'false' to disable trace capture entirely (no collector work, no flush).
OBSERVABILITY_ENABLED=true
# Optional collector bounds overrides (defaults: 2 KB string, 50 array, 8 MB/1000 events).
OBSERVABILITY_MAX_EVENTS=1000
