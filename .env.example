NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server-only; never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (server-side migrations/admin only).
DATABASE_URL=
# Server-side AI (managed model). AI_API_KEY is the provider key; set AI_PROVIDER/AI_MODEL.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
AI_BASE_URL=
AI_ALLOWED_BASE_URLS=
# Server-side Firecrawl research/search key.
FIRECRAWL_API_KEY=
OAUTH_APP_URL=http://localhost:3000
