# ------------------------------------------------------------------------------
# Supabase
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ------------------------------------------------------------------------------
# AI — Execution mode & providers
# Mode: 'production' (Vercel AI Gateway: gpt-5-nano, gemini-2.5-flash-lite, nemotron-3.5-lightning-free) | 'test' (Vercel AI Gateway: nvidia/nemotron-3.5-lightning-free)
# ------------------------------------------------------------------------------
AI_MODE=test


# Groq
GROQ_API_KEY=

# Dahl (used project-wide)
DAHL_API_KEY=
DAHL_BASE_URL=https://inference.dahl.global/v1

# SovereignEG
SOVEREIGNEG_API_KEY=
SOVEREIGNEG_BASE_URL=https://backend.sovereigneg.com/v1

# Apinex
APINEX_API_KEY=
APINEX_BASE_URL=https://api.apinex.bond/v1

# Vercel AI Gateway (test primary: nvidia/nemotron-3.5-lightning-free)
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# ------------------------------------------------------------------------------
# Research / search keys
# ------------------------------------------------------------------------------
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=

# ------------------------------------------------------------------------------
# Publishing (Facebook via Composio) — server-only
# Provider: composio | fake | disabled  (fake refused in production)
# ------------------------------------------------------------------------------
PUBLISHING_PROVIDER=fake
COMPOSIO_API_KEY=
COMPOSIO_FACEBOOK_AUTH_CONFIG_ID=
PUBLISHING_FAKE_OUTCOME=confirmed   # fake only: confirmed | failed | uncertain | timeout
CRON_SECRET=                        # long random string for /api/cron/publish-due

# ------------------------------------------------------------------------------
# Meta Ads reporting (read-only). Server-only; never prefix with NEXT_PUBLIC_.
# ------------------------------------------------------------------------------
META_ADS_PROVIDER=disabled            # composio | fake | disabled  (fake is refused in production)
COMPOSIO_META_ADS_AUTH_CONFIG_ID=     # ac_... Composio-managed Meta Ads (metaads) auth config

# ------------------------------------------------------------------------------
# Admin observability operator (local dev)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USER_ID=
